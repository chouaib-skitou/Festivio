{
  "name": "festivio-backend",
  "version": "1.3.0",
  "description": "Festivio Node.js and Express backend with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:demo": "node scripts/seed.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check \"server.js\" \"config/db.js\" \"middlewares/authMiddleware.js\"",
    "test": "jest",
    "test:ci": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT"
}
