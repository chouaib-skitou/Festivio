NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/festivio
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=10

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
CSRF_SECRET=replace-with-a-third-independent-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=festivio_refresh
CSRF_SESSION_COOKIE_NAME=festivio_csrf_session

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Festivio <noreply@festivio.local>
IMGUR_CLIENT_ID=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

# Required only when running `npm run seed:demo` outside Docker Compose.
DEMO_PASSWORD=
