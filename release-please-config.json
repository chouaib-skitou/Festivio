{
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "Festivio",
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
